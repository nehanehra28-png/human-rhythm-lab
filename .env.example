# Copy to apps/web/.env.local for local development. Never commit that file.
# Without public Supabase variables the app shows a local sample-data preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never add NEXT_PUBLIC to the variables below.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
APP_URL=http://localhost:3000
CRON_SECRET=
# Required for cloud-connected local development and every Vercel Preview.
# Keep the public URL/key and server key from this SAME development project.
NEXT_PUBLIC_SUPABASE_DEV_PROJECT_REF=bmrjzdnpiujfguycurrq
# Server-only: a separate random secret of at least32 characters; never commit its value.
RATE_LIMIT_HASH_KEY=
# Fail closed during the pilot until migration007 and cloud tests are approved/passed.
AI_REVIEWS_ENABLED=false
PROGRAM_UPLOADS_ENABLED=false
